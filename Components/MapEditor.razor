@using System.Globalization
@implements IAsyncDisposable
@inject ProjectService Store
@inject IJSRuntime JS

<div class="app @(SelectedPin is not null || OpenSheet is not null ? "reading" : "")">

    @* ===================== Panel izquierdo: proyecto y capas ===================== *@
    <aside class="panel panel-left">
        <h1>Mapa de Mundos</h1>

        @if (!Store.Loaded)
        {
            <p class="muted">Cargando proyecto...</p>
        }
        else
        {
            <label class="field">
                <span>Proyecto</span>
                <input type="text" @bind="Store.Project.Name" @bind:event="oninput" @bind:after="OnDataChanged" />
            </label>

            <div class="btn-row">
                <button class="btn" @onclick="LoadImageAsync">Cargar imagen</button>
                <button class="btn" @onclick="ExportAsync">Exportar</button>
                <button class="btn" @onclick="ImportAsync">Importar</button>
                <button class="btn danger" @onclick="NewProjectAsync">Nuevo</button>
            </div>

            <GeneratorPanel OnGenerated="OnMapGenerated" OnPopulated="OnRegionsChanged" OnStartSketch="StartSketch" />
            <RegionPanel OnChanged="OnRegionsChanged" />
            <WikiList Current="CurrentTarget" OnOpen="OpenTargetAsync" />

            <div class="section-head">
                <h2>Capas</h2>
                <button class="btn small" @onclick="AddLayer">+ Capa</button>
            </div>

            <div class="layers">
                @foreach (var layer in Store.Project.Layers)
                {
                    <div class="layer @(layer.Id == _activeLayerId ? "active" : "")"
                         @key="layer.Id"
                         aria-current="@(layer.Id == _activeLayerId ? "true" : null)"
                         @onclick="() => _activeLayerId = layer.Id"
                         @onfocusin="() => _activeLayerId = layer.Id">
                        @* onfocusin: al llegar con Tab a cualquier control de la fila, la capa queda activa. *@
                        <input type="checkbox" title="Mostrar u ocultar la capa"
                               aria-label="Mostrar la capa @layer.Name"
                               @bind="layer.Visible" @bind:after="OnDataChanged" />
                        <input type="color" title="Color de los pines de esta capa"
                               aria-label="Color de la capa @layer.Name"
                               @bind="layer.Color" @bind:after="OnDataChanged" />
                        <input type="text" class="layer-name" aria-label="Nombre de la capa"
                               @bind="layer.Name" @bind:event="oninput" @bind:after="OnDataChanged" />
                        <span class="count" title="Cantidad de pines">@PinCount(layer)</span>
                        <button class="icon-btn" title="Subir (se dibuja encima)"
                                aria-label="Subir la capa @layer.Name"
                                @onclick="() => MoveLayer(layer, -1)" @onclick:stopPropagation="true">↑</button>
                        <button class="icon-btn" title="Bajar"
                                aria-label="Bajar la capa @layer.Name"
                                @onclick="() => MoveLayer(layer, 1)" @onclick:stopPropagation="true">↓</button>
                        <button class="icon-btn" title="Eliminar capa"
                                aria-label="Eliminar la capa @layer.Name"
                                disabled="@(Store.Project.Layers.Count == 1)"
                                @onclick="() => RemoveLayerAsync(layer)" @onclick:stopPropagation="true">x</button>
                    </div>
                }
            </div>

            <p class="hint">
                La capa resaltada recibe los pines nuevos. Las capas de arriba se dibujan sobre las de abajo.
            </p>
        }
    </aside>

    @* ===================== Centro: barra de herramientas y mapa ===================== *@
    <main class="center">
        <div class="toolbar">
            <div class="seg">
                <button class="btn @(_mode == Mode.Navigate ? "on" : "")"
                        aria-pressed="@(_mode == Mode.Navigate ? "true" : "false")"
                        @onclick="() => _mode = Mode.Navigate">Navegar</button>
                <button class="btn @(_mode == Mode.AddPin ? "on" : "")"
                        aria-pressed="@(_mode == Mode.AddPin ? "true" : "false")"
                        @onclick="() => _mode = Mode.AddPin">Colocar pines</button>
                <button class="btn @(_mode == Mode.Inspect ? "on" : "")"
                        aria-pressed="@(_mode == Mode.Inspect ? "true" : "false")"
                        disabled="@(Store.Project.Generator is null)"
                        title="@(Store.Project.Generator is null ? "Solo para mapas generados" : "Clic en el mapa para ver los datos de una celda")"
                        @onclick="EnterInspectModeAsync">Ver celdas</button>
            </div>

            <label class="check">
                <span>Vista</span>
                <select value="@_view" @onchange="OnViewChangedAsync"
                        disabled="@(Store.Project.Generator is null)"
                        title="@(Store.Project.Generator is null ? "Solo para mapas generados" : "Qué muestra el mapa")">
                    @foreach (var (view, name) in ThematicRenderer.Views)
                    {
                        <option value="@view">@name</option>
                    }
                </select>
            </label>

            <label class="check">
                <input type="checkbox" @bind="_showLabels" /> Etiquetas
            </label>

            <button class="btn" @onclick="FitAsync">Ajustar a pantalla</button>

            <span class="status">@Store.SaveStatus</span>
            <span class="status msg">@_message</span>
        </div>

        @* Barra de dibujo: solo en "Dibujar costa". *@
        @if (_mode == Mode.Sketch)
        {
            <div class="placebar">
                <span class="placebar-label">
                    <strong>Dibujar:</strong> @SketchToolHint
                    Botón del medio: mover el mapa. Rueda: zoom.
                </span>

                @* Herramienta: qué se dibuja con el próximo trazo. *@
                <div class="seg" role="group" aria-label="Qué dibujar">
                    @foreach (var (tool, name) in SketchTools)
                    {
                        <button class="btn small @(_sketchTool == tool ? "on" : "")"
                                aria-pressed="@(_sketchTool == tool ? "true" : "false")"
                                @onclick="() => _sketchTool = tool">@name</button>
                    }
                </div>
                @if (_sketchTool == SketchTool.Biome)
                {
                    <select class="sketch-biome" @bind="_sketchBiome" aria-label="Bioma de la zona">
                        @foreach (var biome in BiomeNames.Land)
                        {
                            <option value="@biome">@BiomeNames.Of(biome)</option>
                        }
                    </select>
                }

                <div class="btn-row">
                    <button class="btn small" disabled="@(!Store.CanUndoSketch)"
                            @onclick="Store.UndoSketchStroke">Deshacer</button>
                    <button class="btn small" disabled="@(Store.SketchStrokeCount == 0)"
                            @onclick="ClearSketchAsync">Borrar todo</button>
                    <button class="btn small" @onclick="() => _mode = Mode.Navigate">Terminar</button>
                </div>
            </div>
        }

        @* Barra de colocación: solo en "Colocar pines". El tipo elegido es el de los pines nuevos. *@
        @if (_mode == Mode.AddPin)
        {
            <div class="placebar">
                <span class="placebar-label">Pin nuevo: <strong>@_newPinKind</strong></span>
                <KindPicker Compact="true" @bind-Value="_newPinKind" />
            </div>
        }

        @* Este div NO lleva atributo style: mapview.js le pone una variable CSS. *@
        <div class="viewport @ModeClass" @ref="_viewport">

            @* .world tampoco lleva style: mapview.js lo mueve y lo escala. *@
            <div class="world" @ref="_world">
                @if (!string.IsNullOrEmpty(Store.ImageDataUrl))
                {
                    <img src="@Store.ImageDataUrl" alt="Mapa base" draggable="false" />
                }
                else if (_mode == Mode.Sketch)
                {
                    @* Sin imagen todavía: una hoja en blanco del tamaño del mapa para dibujar encima. *@
                    <div class="sketch-sheet"></div>
                }

                @* Islas dibujadas y trazo en curso (el "d" del path vivo lo escribe mapview.js). *@
                @if (_mode == Mode.Sketch)
                {
                    <svg class="sketch-live" viewBox="0 0 @F(MapGenerator.Width) @F(MapGenerator.Height)"
                         preserveAspectRatio="none" aria-hidden="true">
                        @foreach (var island in Store.Project.SketchDraft)
                        {
                            <path class="island" d="@IslandPath(island)" />
                        }
                        @foreach (var feature in Store.Project.SketchFeatureDraft)
                        {
                            @switch (feature.Kind)
                            {
                                case SketchFeatureKind.Water:
                                    <path class="water" d="@IslandPath(feature.Points)" />
                                    break;
                                case SketchFeatureKind.Mountains:
                                    <path class="range" d="@IslandPath(feature.Points, closed: false)" />
                                    break;
                                default:
                                    @* Color del bioma (fijo, del dibujo del mapa): se ve qué zona es cuál. *@
                                    <path class="zone" d="@IslandPath(feature.Points)"
                                          style="@($"fill:{SvgMapRenderer.BiomeColor(feature.Biome ?? Biome.Grassland)}")" />
                                    break;
                            }
                        }
                        <path class="live" />
                    </svg>
                }

                @* La vista elegida (reinos, altura...) es otra imagen del mismo tamaño, encima del terreno. *@
                @if (ViewImage is { } viewImage)
                {
                    <img class="view-layer" src="@viewImage" alt="" draggable="false" />
                }

                @if (_view == MapView.Regions && Store.WorldReady)
                {
                    foreach (var label in ThematicRenderer.Labels(Store.GetWorld()!, Store.Project.Regions))
                    {
                        <span class="region-label" style="@LabelStyle(label)">@label.Name</span>
                    }
                }

                @* Contorno de la celda seleccionada. El SVG tiene el mismo tamaño que el mapa
                   generado, así que los vértices de la malla se usan tal cual. *@
                @if (SelectedCellsPath is { } path)
                {
                    var world = Store.GetWorld()!;
                    <svg class="cell-highlight" viewBox="0 0 @F(world.Mesh.Width) @F(world.Mesh.Height)"
                         preserveAspectRatio="none" aria-hidden="true">
                        <path d="@path" />
                    </svg>
                }

                @if (Store.Loaded)
                {
                    // Pines que son capital de algún reino: se calculan una vez por dibujo.
                    var capitals = Store.Project.Regions
                        .Where(r => r.CapitalPinId is not null)
                        .Select(r => r.CapitalPinId!.Value)
                        .ToHashSet();

                    for (var i = 0; i < Store.Project.Layers.Count; i++)
                    {
                        var layer = Store.Project.Layers[i];
                        if (!layer.Visible)
                        {
                            continue;
                        }

                        // La primera capa de la lista queda arriba: mayor z-index.
                        var z = Store.Project.Layers.Count - i;

                        foreach (var pin in Store.Project.Pins.Where(p => p.LayerId == layer.Id))
                        {
                            var isSelected = pin.Id == _selectedPinId;
                            var isCapital = capitals.Contains(pin.Id);

                            <div class="pin @PinClasses(pin) @(isSelected ? "selected" : "") @(isCapital ? "capital" : "")"
                                 @key="pin.Id"
                                 data-pin-id="@pin.Id"
                                 style="@PinStyle(pin, layer, z, isSelected)"
                                 role="button" tabindex="0"
                                 aria-label="@(isCapital ? "Capital" : pin.Kind): @pin.Title"
                                 aria-pressed="@(isSelected ? "true" : "false")"
                                 @onkeydown="e => OnPinKeyDown(e, pin.Id)"
                                 @onclick="() => SelectPin(pin.Id)"
                                 @onclick:stopPropagation="true">
                                <span class="dot"><PinIcon Kind="@pin.Kind" Capital="isCapital" /></span>
                                @if (_showLabels || isSelected)
                                {
                                    <span class="label">@pin.Title</span>
                                }
                            </div>
                        }
                    }
                }
            </div>

            @* Leyenda: fuera de .world para que no se mueva ni se agrande con el mapa. *@
            @if (ThematicRenderer.Legend(_view) is { } scale)
            {
                <div class="legend" aria-label="Leyenda">
                    <span class="legend-title">@scale.Title</span>
                    <span class="legend-bar" style="@LegendStyle(scale)"></span>
                    <span class="legend-range"><span>@scale.MinLabel</span><span>@scale.MaxLabel</span></span>
                </div>
            }
            else if (_view == MapView.Regions && Store.Project.Regions.Count > 0)
            {
                <div class="legend" aria-label="Leyenda">
                    <span class="legend-title">Reinos</span>
                    @foreach (var region in Store.Project.Regions)
                    {
                        <span class="legend-item">
                            <span class="swatch" style="@($"background:{SafeColor(region.Color)}")"></span>@region.Name@CapitalText(region)
                        </span>
                    }
                </div>
            }

            @if (Store.Loaded && string.IsNullOrEmpty(Store.ImageDataUrl) && _mode != Mode.Sketch)
            {
                <div class="empty">
                    <p>
                        Cargá una imagen de mapa (PNG, JPG o SVG) con el botón "Cargar imagen",<br />
                        por ejemplo una exportada desde Azgaar, o creá una con "Generar mapa".
                    </p>
                </div>
            }
        </div>
    </main>

    @* ===================== Panel derecho: ficha del pin ===================== *@
    <aside class="panel panel-right">
        @if (Store.Loaded && SelectedPin is { } selectedPin)
        {
            <h2>@selectedPin.Title</h2>

            <label class="field">
                <span>Título</span>
                <NameInput @bind-Value="selectedPin.Title" @bind-Value:after="() => OnPinChanged(selectedPin)" />
            </label>

            @* Tipo: se muestra el actual y, al tocar "Cambiar", la grilla con todos los tipos. *@
            <div class="field">
                <span>Tipo</span>
                <div class="kind-row">
                    <span class="kind-preview"><PinIcon Kind="@selectedPin.Kind" /></span>
                    <span class="kind-name">@selectedPin.Kind</span>
                    <button type="button" class="btn small" aria-expanded="@(_choosingKind ? "true" : "false")"
                            @onclick="() => _choosingKind = !_choosingKind">@(_choosingKind ? "Listo" : "Cambiar")</button>
                </div>
                @if (_choosingKind)
                {
                    <KindPicker Value="@selectedPin.Kind" ValueChanged="kind => ChangeKind(selectedPin, kind)" />
                }
            </div>

            @* Tamaño: la importancia del lugar en el mapa. *@
            <div class="field">
                <span id="tamano-pin">Tamaño</span>
                <div class="seg" role="group" aria-labelledby="tamano-pin">
                    @foreach (var (size, name) in SizeNames)
                    {
                        <button type="button" class="btn small @(selectedPin.Size == size ? "on" : "")"
                                aria-pressed="@(selectedPin.Size == size ? "true" : "false")"
                                @onclick="() => ChangeSize(selectedPin, size)">@name</button>
                    }
                </div>
            </div>

            <label class="field">
                <span>Capa</span>
                <select @bind="selectedPin.LayerId" @bind:after="() => OnPinChanged(selectedPin)">
                    @foreach (var l in Store.Project.Layers)
                    {
                        <option value="@l.Id">@l.Name</option>
                    }
                </select>
            </label>

            @* Reino: se calcula por la celda donde está el pin, así que cambia si se lo mueve. *@
            @if (Store.Project.Generator is not null)
            {
                var region = Store.RegionAt(selectedPin);
                var capitalOf = Store.CapitalOf(selectedPin);

                <div class="field">
                    <span>Reino</span>
                    <p class="field-value">@(region?.Name ?? "Sin reino")</p>
                </div>

                @if (region is not null)
                {
                    <label class="check field">
                        <input type="checkbox" checked="@(capitalOf == region)"
                               @onchange="e => SetCapital(region, selectedPin, e)" />
                        Capital de @region.Name
                    </label>
                }

                @if (capitalOf is not null && capitalOf != region)
                {
                    <p class="hint">Es la capital de @capitalOf.Name, pero está fuera de su territorio.</p>
                }
            }

            <EntryText Target="WikiTarget.Pin(selectedPin.Id)" OnOpen="OpenTargetAsync" />

            <p class="hint">
                Posición: @FormatPercent(selectedPin.X) / @FormatPercent(selectedPin.Y).
                Arrastrá el pin en el mapa para moverlo.
            </p>

            <button class="btn danger" @onclick="() => DeletePinAsync(selectedPin)">Eliminar pin</button>
        }
        else if (Store.Loaded && OpenSheet is { } sheet)
        {
            <EntrySheet Target="sheet" OnOpen="OpenTargetAsync" OnShow="CenterOnAsync"
                        OnClose="() => _sheet = null" OnRegionChanged="OnRegionsChanged" />
        }
        else if (Store.Loaded && _selectedCells.Count > 0 && Store.WorldReady)
        {
            <CellPanel World="Store.GetWorld()!" Cells="_selectedCells"
                       OnClearSelection="ClearCellSelection" OnEdited="OnCellsEdited" />
        }
        else if (Store.Loaded && _mode == Mode.AddPin)
        {
            <p class="muted">Elegí un tipo en la barra de arriba del mapa y hacé clic donde quieras colocarlo.</p>
        }
        else if (Store.Loaded && _mode == Mode.Inspect)
        {
            <p class="muted">
                Hacé clic en el mapa para ver los datos de una celda. Shift + clic agrega o quita
                celdas; Shift + arrastrar las pinta.
            </p>
        }
        else if (Store.Loaded)
        {
            <p class="muted">
                Seleccioná un pin para ver y editar su ficha, o activá "Colocar pines" y hacé clic en el mapa para crear uno.
            </p>
        }
    </aside>
</div>

@code {
    private enum Mode { Navigate, AddPin, Inspect, Sketch }

    // Referencias a elementos del DOM que se le pasan a JavaScript.
    private ElementReference _viewport;
    private ElementReference _world;

    private IJSObjectReference? _mapJs;
    private DotNetObjectReference<MapEditor>? _self;

    private Mode _mode = Mode.Navigate;
    private string _newPinKind = MapPin.Kinds[0]; // tipo de los pines que se colocan
    private SketchTool _sketchTool = SketchTool.Land;   // qué se dibuja con el próximo trazo
    private Biome _sketchBiome = Biome.TemperateForest; // bioma de las zonas dibujadas
    private bool _choosingKind;                   // la ficha muestra la grilla de tipos
    private MapView _view = MapView.Terrain;          // vista que se muestra
    private MapView _requestedView = MapView.Terrain; // última vista elegida (puede estar preparándose)
    private Guid _activeLayerId;
    private Guid? _selectedPinId;
    private WikiTarget? _sheet;                 // ficha de reino o suelta abierta en el panel derecho
    private readonly HashSet<int> _selectedCells = new(); // índices de celdas de la malla del mundo generado
    private bool _paintAdds;                  // el pincel agrega (true) o quita (false) celdas
    private (double X, double Y) _lastPaint;  // último punto pintado, en píxeles del mapa
    private int _lastPaintCell = -1;
    private bool _showLabels = true;
    private bool _needsFit;
    private string _message = "";

    private MapPin? SelectedPin =>
        _selectedPinId is { } id ? Store.Project.Pins.FirstOrDefault(p => p.Id == id) : null;

    private MapLayer? ActiveLayer =>
        Store.Project.Layers.FirstOrDefault(l => l.Id == _activeLayerId);

    // ------------------------------------------------------------ ciclo de vida

    protected override async Task OnInitializedAsync()
    {
        Store.StatusChanged += OnStatusChanged;
        Store.SketchChanged += OnStatusChanged; // el dibujo cambió: se redibujan las islas

        await Store.InitAsync();

        _activeLayerId = Store.Project.Layers[0].Id;
        _needsFit = !string.IsNullOrEmpty(Store.ImageDataUrl);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Recién ahora existen los elementos del DOM, así que se le entregan a JavaScript.
            _self = DotNetObjectReference.Create(this);
            _mapJs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/mapview.js");
            await _mapJs.InvokeVoidAsync("init", _viewport, _world, _self);
        }

        if (_needsFit && _mapJs is not null)
        {
            _needsFit = false;
            await _mapJs.InvokeVoidAsync("fit");
        }
    }

    public async ValueTask DisposeAsync()
    {
        Store.StatusChanged -= OnStatusChanged;
        Store.SketchChanged -= OnStatusChanged;

        if (_mapJs is not null)
        {
            await _mapJs.InvokeVoidAsync("dispose");
            await _mapJs.DisposeAsync();
        }

        _self?.Dispose();
    }

    private void OnStatusChanged() => _ = InvokeAsync(StateHasChanged);

    // ------------------------------------------------ llamadas desde JavaScript

    /// <summary>mapview.js avisa de un clic simple sobre el mapa (x e y entre 0 y 1).</summary>
    [JSInvokable]
    public Task OnMapClick(double x, double y) => InvokeAsync(() =>
    {
        _sheet = null; // un clic en el mapa cierra la ficha abierta, como deselecciona un pin

        if (_mode == Mode.AddPin)
        {
            var layer = ActiveLayer ?? Store.Project.Layers[0];
            layer.Visible = true; // si no, el pin nuevo quedaría invisible
            _activeLayerId = layer.Id;

            var pin = Store.AddPin(layer.Id, x, y, _newPinKind);
            _choosingKind = false;
            _selectedPinId = pin.Id;
        }
        else if (_mode == Mode.Inspect && Store.GetWorld() is { } world)
        {
            // El clic llega normalizado (0 a 1): se pasa a píxeles del mapa generado.
            var cell = world.Mesh.FindCell(x * world.Mesh.Width, y * world.Mesh.Height);
            _selectedCells.Clear();
            if (cell >= 0) _selectedCells.Add(cell);
            _selectedPinId = null;
        }
        else
        {
            _selectedPinId = null;
            _selectedCells.Clear();
        }

        StateHasChanged();
    });

    /// <summary>mapview.js avisa de que se terminó de arrastrar un pin.</summary>
    [JSInvokable]
    public Task OnPinMoved(string id, double x, double y) => InvokeAsync(() =>
    {
        if (Guid.TryParse(id, out var pinId))
        {
            Store.MovePin(pinId, x, y); // mover un pin generado también lo "adopta" (ver MovePin)
        }

        StateHasChanged();
    });

    /// <summary>
    /// mapview.js avisa de cada punto del pincel de selección (Shift + arrastrar en "Ver celdas").
    /// start es true al apretar el botón: si esa primera celda ya estaba elegida, el pincel borra
    /// en vez de agregar. Así Shift + clic sobre una celda elegida la quita.
    /// </summary>
    [JSInvokable]
    public Task OnCellPaint(double x, double y, bool start) => InvokeAsync(() =>
    {
        if (_mode != Mode.Inspect || !Store.WorldReady) return;

        var mesh = Store.GetWorld()!.Mesh;
        var px = x * mesh.Width;
        var py = y * mesh.Height;

        if (start)
        {
            var first = mesh.FindCell(px, py);
            if (first < 0) return;
            _paintAdds = !_selectedCells.Contains(first);
            Paint(first);
            _lastPaint = (px, py);
            _lastPaintCell = first;
            _selectedPinId = null;
            StateHasChanged();
            return;
        }

        // Entre un aviso del mouse y el siguiente el cursor puede saltar varias celdas: se recorre
        // el tramo en pasos de media celda para no dejar huecos en la pincelada.
        var (lastX, lastY) = _lastPaint;
        var length = Math.Sqrt((px - lastX) * (px - lastX) + (py - lastY) * (py - lastY));
        var steps = Math.Max(1, (int)Math.Ceiling(length / (mesh.Spacing / 2)));
        for (var s = 1; s <= steps; s++)
        {
            var t = (double)s / steps;
            var cell = mesh.FindCell(lastX + (px - lastX) * t, lastY + (py - lastY) * t, _lastPaintCell);
            if (cell < 0) continue;
            Paint(cell);
            _lastPaintCell = cell;
        }
        _lastPaint = (px, py);
        StateHasChanged();
    });

    private void Paint(int cell)
    {
        if (_paintAdds) _selectedCells.Add(cell);
        else _selectedCells.Remove(cell);
    }

    // ------------------------------------------------------------ acciones

    private void ClearCellSelection() => _selectedCells.Clear();

    // ------------------------------------------------------------ dibujo de costa

    /// <summary>Entra al modo "Dibujar costa" (lo pide el panel del generador).</summary>
    private void StartSketch()
    {
        _mode = Mode.Sketch;
        _selectedPinId = null;
        _selectedCells.Clear();

        // Sin imagen aparece la hoja en blanco: hay que ajustar el visor a ella.
        if (string.IsNullOrEmpty(Store.ImageDataUrl)) _needsFit = true;
    }

    private async Task ClearSketchAsync()
    {
        if (await JS.InvokeAsync<bool>("confirm", $"¿Borrar los {Store.SketchStrokeCount} trazos del dibujo?"))
            Store.ClearSketch();
    }

    /// <summary>mapview.js avisa de un trazo terminado: coordenadas normalizadas [x0, y0, x1, y1, ...].</summary>
    [JSInvokable]
    public Task OnSketchStroke(double[] points) => InvokeAsync(() =>
    {
        if (_mode != Mode.Sketch) return;
        _message = Store.AddSketchStroke(points, _sketchTool, _sketchBiome) ? "" : "Ese trazo es muy chico: no se agregó.";
        StateHasChanged();
    });

    /// <summary>mapview.js avisa de un clic con la goma: coordenadas normalizadas.</summary>
    [JSInvokable]
    public Task OnSketchErase(double x, double y) => InvokeAsync(() =>
    {
        if (_mode != Mode.Sketch || _sketchTool != SketchTool.Eraser) return;
        _message = Store.EraseSketchAt(x, y) ? "" : "Ahí no hay ningún trazo.";
        StateHasChanged();
    });

    // Isla del dibujo como path de SVG, en las coordenadas del viewBox (el tamaño del mapa).
    private static string IslandPath(double[] island, bool closed = true)
    {
        var d = new System.Text.StringBuilder();
        for (var i = 0; i < island.Length; i += 2)
        {
            d.Append(i == 0 ? 'M' : 'L')
             .Append(F(island[i] * MapGenerator.Width)).Append(' ')
             .Append(F(island[i + 1] * MapGenerator.Height));
        }
        return closed ? d.Append('Z').ToString() : d.ToString(); // las cordilleras quedan abiertas
    }

    private static readonly (SketchTool Tool, string Name)[] SketchTools =
    {
        (SketchTool.Land, "Tierra"), (SketchTool.Water, "Agua"), (SketchTool.Mountains, "Montañas"),
        (SketchTool.Biome, "Bioma"), (SketchTool.Eraser, "Goma")
    };

    // Qué hace el próximo trazo, en la barra de dibujo.
    private string SketchToolHint => _sketchTool switch
    {
        SketchTool.Water => "arrastrá un contorno para un lago, una bahía o para borrar tierra.",
        SketchTool.Mountains => "arrastrá una línea para una cordillera.",
        SketchTool.Biome => $"arrastrá un contorno: esa zona será {BiomeNames.Of(_sketchBiome).ToLowerInvariant()}.",
        SketchTool.Eraser => "hacé clic sobre un trazo para borrarlo.",
        _ => "arrastrá un contorno para una isla o para sumar tierra."
    };

    // El panel de celdas cambió el mapa: no hay nada que hacer acá, pero recibir el aviso hace
    // que el editor se vuelva a dibujar con la imagen nueva.
    private void OnCellsEdited() { }

    // Lo mismo para los cambios de reinos (nombres, colores): el editor vuelve a dibujar la vista.
    private void OnRegionsChanged() { }

    // ------------------------------------------------------------ fichas

    /// <summary>Ficha de reino o suelta abierta, si todavía existe (pudo borrarse desde otro lado).</summary>
    private WikiTarget? OpenSheet => _sheet is { } sheet && Store.Exists(sheet) ? sheet : null;

    /// <summary>Lo que muestra el panel derecho, para resaltarlo en la lista de fichas.</summary>
    private WikiTarget? CurrentTarget => SelectedPin is { } pin ? WikiTarget.Pin(pin.Id) : OpenSheet;

    /// <summary>
    /// Abre una ficha (desde la lista, un enlace o una mención). Un lugar se selecciona como si se
    /// hubiera hecho clic en su pin; un reino o una ficha suelta se abren en el panel derecho.
    /// Si es un lugar o un reino, el mapa se centra en él.
    /// </summary>
    private async Task OpenTargetAsync(WikiTarget target)
    {
        if (target.Kind == WikiTargetKind.Pin)
        {
            SelectPin(target.Id);
            if (SelectedPin is { } pin)
                ShowLayerOf(pin); // si su capa estaba oculta, no se vería al centrar
        }
        else
        {
            _sheet = target;
            _selectedPinId = null;
            _selectedCells.Clear();
        }

        if (target.Kind != WikiTargetKind.Entry)
            await CenterOnAsync(target);
    }

    private void ShowLayerOf(MapPin pin)
    {
        if (Store.Project.Layers.FirstOrDefault(l => l.Id == pin.LayerId) is { Visible: false } layer)
        {
            layer.Visible = true;
            Store.RequestSave();
        }
    }

    /// <summary>
    /// Centra el mapa en un lugar (su pin) o en un reino (su capital o, si no tiene, el punto
    /// donde va su nombre en la vista de reinos).
    /// </summary>
    private async Task CenterOnAsync(WikiTarget target)
    {
        if (_mapJs is null) return;

        (double X, double Y)? point = null;
        if (target.Kind == WikiTargetKind.Pin && Store.Project.Pins.FirstOrDefault(p => p.Id == target.Id) is { } pin)
        {
            point = (pin.X, pin.Y);
        }
        else if (target.Kind == WikiTargetKind.Region && Store.Project.Regions.FirstOrDefault(r => r.Id == target.Id) is { } region)
        {
            if (region.CapitalPinId is { } capitalId && Store.Project.Pins.FirstOrDefault(p => p.Id == capitalId) is { } capital)
                point = (capital.X, capital.Y);
            else if (region.Cells.Count > 0 && Store.GetWorld() is { } world &&
                     ThematicRenderer.Labels(world, Store.Project.Regions).FirstOrDefault(l => l.Name == region.Name) is { } label)
                point = (label.X, label.Y);
        }

        if (point is { } p)
            await _mapJs.InvokeVoidAsync("centerOn", p.X, p.Y);
    }

    /// <summary>
    /// Cambia la vista del mapa. La primera vez, dibujarla (y quizás rearmar el mundo) demora
    /// un poco: se avisa antes, como al entrar en "Ver celdas".
    /// </summary>
    private async Task OnViewChangedAsync(ChangeEventArgs e)
    {
        if (!Enum.TryParse<MapView>(e.Value?.ToString(), out var view)) return;
        _requestedView = view;

        if (!Store.ViewReady(view))
        {
            _message = "Preparando la vista...";
            StateHasChanged();
            await Task.Delay(1); // deja que el navegador muestre el aviso antes del trabajo pesado
            Store.GetViewImage(view);
            _message = "";
        }

        // Si mientras se preparaba se eligió otra vista, gana la última elegida: si no, una vista
        // lenta que termina tarde pisaría a una rápida elegida después.
        if (_requestedView == view)
        {
            _view = view;
        }
    }

    private void OnDataChanged() => Store.RequestSave();

    // Un cambio en la ficha del pin también lo "adopta": si era generado, deja de serlo y se
    // conserva al volver a poblar el mapa.
    private void OnPinChanged(MapPin pin)
    {
        pin.Generated = false;
        Store.RequestSave();
    }

    // El mapa nuevo puede tener otro tamaño que la imagen anterior: se vuelve a ajustar.
    // La celda seleccionada era de otro mundo, así que se descarta.
    private void OnMapGenerated()
    {
        _needsFit = true;
        _selectedCells.Clear();

        // Si se estaba dibujando, se vuelve a navegar: el contorno ya no hace falta encima del
        // mapa nuevo (el dibujo se conserva; "Dibujar en el mapa" lo vuelve a mostrar).
        if (_mode == Mode.Sketch) _mode = Mode.Navigate;
    }

    /// <summary>
    /// Cambia el tipo del pin. Si el título todavía era el nombre del tipo (el que se pone al
    /// crearlo), se cambia también; si el autor ya le puso un nombre propio, se respeta.
    /// </summary>
    private void ChangeKind(MapPin pin, string kind)
    {
        // Mismo criterio para el título y el tamaño: si todavía eran los del tipo anterior, pasan
        // a los del tipo nuevo; si el autor los había cambiado, se respetan.
        if (pin.Title == pin.Kind) pin.Title = kind;
        if (pin.Size == MapPin.DefaultSize(pin.Kind)) pin.Size = MapPin.DefaultSize(kind);
        pin.Kind = kind;
        _choosingKind = false;
        OnPinChanged(pin);
    }

    private void ChangeSize(MapPin pin, PinSize size)
    {
        pin.Size = size;
        OnPinChanged(pin);
    }

    private static readonly (PinSize Size, string Name)[] SizeNames =
    {
        (PinSize.Small, "Chico"), (PinSize.Medium, "Mediano"), (PinSize.Large, "Grande")
    };

    // Clases de forma y tamaño del pin, para el CSS: por ejemplo "shape-square size-large".
    private static string PinClasses(MapPin pin) =>
        $"shape-{MapPin.ShapeOf(pin.Kind).ToString().ToLowerInvariant()} size-{pin.Size.ToString().ToLowerInvariant()}";

    private void SelectPin(Guid id)
    {
        _selectedPinId = id;
        _sheet = null;
        _selectedCells.Clear();
        _choosingKind = false;

        // La ficha muestra el reino del pin, que necesita el mundo en memoria. Si hay que
        // rearmarlo (tras recargar la página), mejor acá que en medio del dibujo de la ficha.
        Store.GetWorld();
    }

    private void SetCapital(Region region, MapPin pin, ChangeEventArgs e) =>
        Store.SetCapital(region, pin, e.Value is true);

    /// <summary>
    /// Activa "Ver celdas". Si el mundo no está en memoria (por ejemplo, tras recargar la página)
    /// hay que rearmarlo desde las semillas, y eso demora unos segundos: primero se avisa.
    /// </summary>
    private async Task EnterInspectModeAsync()
    {
        if (!Store.WorldReady)
        {
            _message = "Preparando las celdas...";
            StateHasChanged();
            await Task.Delay(1); // deja que el navegador muestre el aviso antes del trabajo pesado
            Store.GetWorld();
            _message = "";
        }

        _mode = Mode.Inspect;
        _selectedPinId = null;
    }

    // Un div no reacciona solo a Enter o Espacio como un botón: hay que hacerlo a mano.
    private void OnPinKeyDown(KeyboardEventArgs e, Guid id)
    {
        if (e.Key is "Enter" or " ")
        {
            SelectPin(id);
        }
    }

    private async Task FitAsync()
    {
        if (_mapJs is not null)
        {
            await _mapJs.InvokeVoidAsync("fit");
        }
    }

    private async Task LoadImageAsync()
    {
        _message = "";
        var file = await Store.PickFileAsync("image/*", asText: false);
        if (file is null)
        {
            return;
        }

        if (await Store.SetImageAsync(file))
        {
            _needsFit = true;
            _selectedCells.Clear();
            if (_mode == Mode.Inspect)
            {
                _mode = Mode.Navigate; // una imagen cargada no tiene celdas
            }
            _view = _requestedView = MapView.Terrain; // ni vistas de datos
            _message = "Imagen cargada.";
        }
        else
        {
            _message = "Ese archivo no es una imagen.";
        }
    }

    private async Task ExportAsync()
    {
        await Store.ExportAsync();
        _message = "Proyecto exportado.";
    }

    private async Task ImportAsync()
    {
        _message = "";

        // Primero se elige el archivo y recién después se pregunta: el navegador solo
        // permite abrir el selector de archivos justo después de un clic.
        var file = await Store.PickFileAsync(".json,application/json", asText: true);
        if (file is null)
        {
            return;
        }

        var ok = await JS.InvokeAsync<bool>("confirm",
            $"Importar \"{file.Name}\" reemplaza el proyecto actual. ¿Continuar?");
        if (!ok)
        {
            return;
        }

        var (success, message) = await Store.ImportAsync(file.Content);
        _message = message;

        if (success)
        {
            ResetSelection();
        }
    }

    private async Task NewProjectAsync()
    {
        var ok = await JS.InvokeAsync<bool>("confirm",
            "Se borra el proyecto actual (capas, pines e imagen). ¿Continuar? Conviene exportarlo antes.");
        if (!ok)
        {
            return;
        }

        await Store.ResetAsync();
        ResetSelection();
        _message = "Proyecto nuevo.";
    }

    private void ResetSelection()
    {
        _selectedPinId = null;
        _selectedCells.Clear();
        _activeLayerId = Store.Project.Layers[0].Id;
        _needsFit = !string.IsNullOrEmpty(Store.ImageDataUrl);

        // Sin mapa generado no hay celdas ni vistas que ver.
        if (Store.Project.Generator is null)
        {
            if (_mode == Mode.Inspect) _mode = Mode.Navigate;
            _view = _requestedView = MapView.Terrain;
        }
    }

    private void AddLayer()
    {
        var layer = Store.AddLayer();
        _activeLayerId = layer.Id;
    }

    private void MoveLayer(MapLayer layer, int delta) => Store.MoveLayer(layer, delta);

    private async Task RemoveLayerAsync(MapLayer layer)
    {
        var count = PinCount(layer);
        var text = count == 0
            ? $"¿Eliminar la capa \"{layer.Name}\"?"
            : $"¿Eliminar la capa \"{layer.Name}\" y sus {count} pines?";

        if (!await JS.InvokeAsync<bool>("confirm", text))
        {
            return;
        }

        if (SelectedPin?.LayerId == layer.Id)
        {
            _selectedPinId = null;
        }

        Store.RemoveLayer(layer.Id);

        if (_activeLayerId == layer.Id)
        {
            _activeLayerId = Store.Project.Layers[0].Id;
        }
    }

    private async Task DeletePinAsync(MapPin pin)
    {
        var keeps = Store.EntryOf(WikiTarget.Pin(pin.Id)) is not null
            ? " Su texto se conserva como ficha suelta."
            : "";
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar el pin \"{pin.Title}\"?{keeps}"))
        {
            return;
        }

        _selectedPinId = null;
        Store.RemovePin(pin.Id);
    }

    // ------------------------------------------------------------ ayudas de vista

    private int PinCount(MapLayer layer) => Store.Project.Pins.Count(p => p.LayerId == layer.Id);

    // Clase CSS del visor según el modo: cambia el cursor.
    private string ModeClass => _mode switch
    {
        Mode.AddPin => "adding",
        Mode.Inspect => "inspecting",
        // Con la herramienta Montañas el trazo es una línea abierta: mapview.js no lo cierra.
        Mode.Sketch => _sketchTool switch
        {
            SketchTool.Mountains => "sketching sketch-open",   // el trazo en vivo no se cierra
            SketchTool.Eraser => "sketching sketch-eraser",    // clic en vez de trazo
            _ => "sketching"
        },
        _ => ""
    };

    /// <summary>
    /// Contorno de las celdas seleccionadas como un único path de SVG ("M x y L x y ... Z" por
    /// celda), o null si no hay nada para resaltar. Un solo path es mucho más liviano para el
    /// navegador que un polígono por celda cuando se pintan cientos.
    /// </summary>
    private string? SelectedCellsPath
    {
        get
        {
            if (_selectedCells.Count == 0 || !Store.WorldReady) return null;
            var mesh = Store.GetWorld()!.Mesh;
            var d = new System.Text.StringBuilder();
            foreach (var cell in _selectedCells)
            {
                if (mesh.Polygons[cell] is not { } polygon) continue;
                d.Append('M').Append(string.Join('L', polygon.Select(p => $"{F(p.X)} {F(p.Y)}"))).Append('Z');
            }
            return d.Length == 0 ? null : d.ToString();
        }
    }

    private static string F(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    /// <summary>Imagen de la vista elegida para poner encima del terreno, o null en la vista de terreno.</summary>
    private string? ViewImage => _view == MapView.Terrain ? null : Store.GetViewImage(_view);

    // Las etiquetas de reino se ubican como los pines: en porcentaje y con escala inversa.
    private static string LabelStyle(RegionLabel label) => string.Format(CultureInfo.InvariantCulture,
        "left:{0:0.####}%;top:{1:0.####}%;", label.X * 100, label.Y * 100);

    // La barra de la leyenda usa los mismos colores que la escala de la vista.
    private static string LegendStyle(ColorScale scale) =>
        $"background:linear-gradient(to right, {string.Join(", ", scale.Stops)});";

    // El color de un reino viene del proyecto (y de archivos importados): se valida antes de
    // ponerlo en un atributo style, igual que el color de las capas.
    private static string SafeColor(string color) => MapLayer.IsHexColor(color) ? color : Region.Palette[0];

    // Texto que sigue al nombre del reino en la leyenda: ", capital: X" o nada.
    private string CapitalText(Region region) =>
        Store.Project.Pins.FirstOrDefault(p => p.Id == region.CapitalPinId) is { } capital
            ? $", capital: {capital.Title}"
            : "";

    private static string FormatPercent(double value) =>
        (value * 100).ToString("0.0", CultureInfo.InvariantCulture) + "%";

    // OJO con la cultura: en es-AR un double se escribe "12,5" y CSS necesita "12.5".
    // Por eso se formatea siempre con InvariantCulture.
    private static string PinStyle(MapPin pin, MapLayer layer, int z, bool isSelected)
    {
        var color = MapLayer.IsHexColor(layer.Color) ? layer.Color : MapLayer.DefaultColor;
        // --pin-ink: color del ícono, tinta o papel según cuál contraste más con el de la capa.
        return string.Format(CultureInfo.InvariantCulture,
            "left:{0:0.####}%;top:{1:0.####}%;z-index:{2};--pin-color:{3};--pin-ink:{4};",
            pin.X * 100, pin.Y * 100, isSelected ? z + 1000 : z, color, MapLayer.ContrastingInk(color));
    }
}
