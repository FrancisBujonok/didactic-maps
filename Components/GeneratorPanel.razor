@using System.Diagnostics
@using MapaMundos.Generation
@inject ProjectService Store
@inject IJSRuntime JS
@implements IDisposable

@* Panel para generar un mapa al azar. Edita una copia de los parámetros y solo la guarda
   en el proyecto cuando se genera, junto con la imagen. *@
<details class="fold">
    <summary>Generar mapa</summary>

    <p class="hint">Cada etapa tiene su semilla: si cambiás una, las anteriores quedan igual.</p>

    @foreach (var seed in Seeds)
    {
        <div class="seed-row" @key="seed.Id">
            <label for="semilla-@seed.Id" title="@seed.Help">@seed.Label</label>
            <input id="semilla-@seed.Id" type="number" min="1" max="999999"
                   value="@seed.Get()" @onchange="e => SetSeed(seed, e)" />
            <button class="btn small" disabled="@_busy"
                    aria-label="Otra semilla para @seed.Label"
                    @onclick="() => seed.Set(GeneratorSettings.NewSeed())">Otra</button>
        </div>
    }

    <label class="field">
        <span>Tierra: @LandPercent %</span>
        <input type="range" min="20" max="70" step="5"
               @bind="LandPercent" @bind:event="oninput" />
    </label>

    <label class="field">
        <span>Detalle</span>
        <select @bind="_settings.CellSize">
            @foreach (var (size, name) in GeneratorSettings.DetailLevels)
            {
                <option value="@size">@name</option>
            }
        </select>
    </label>

    <label class="field">
        <span>Estilo</span>
        <select @bind="_settings.Style">
            <option value="@MapStyle.Painted">Pintado</option>
            <option value="@MapStyle.Cells">Celdas</option>
        </select>
    </label>

    <div class="btn-row">
        <button class="btn" disabled="@_busy" @onclick="GenerateAsync">Generar</button>
        <button class="btn" disabled="@_busy" @onclick="RandomizeAsync">Todo al azar</button>
    </div>

    <p class="hint" role="status">@(_status ?? "Reemplaza la imagen base. Los pines se mantienen.")</p>

    @if (Store.Project.CellEdits.Count > 0)
    {
        <p class="hint">
            @Store.Project.CellEdits.Count celdas con cambios a mano. Se conservan al generar,
            salvo que cambies la semilla del continente o el detalle.
        </p>
    }

    @* ---- Poblados: se aplican sobre el mapa ya generado, sin cambiar la imagen. *@
    <h3>Poblados</h3>
    <p class="hint">Ciudades, aldeas y lugares donde convienen: junto a ríos, costas y tierra fértil.</p>

    <div class="seed-row">
        <label for="semilla-poblados" title="Dónde caen los poblados y cómo se llaman">Semilla</label>
        <input id="semilla-poblados" type="number" min="1" max="999999"
               value="@_settings.SettlementSeed" @onchange="e => SetSeed(PopulationSeed, e)" />
        <button class="btn small" disabled="@_busy" aria-label="Otra semilla para los poblados"
                @onclick="() => _settings.SettlementSeed = GeneratorSettings.NewSeed()">Otra</button>
    </div>

    <label class="field">
        <span>Cantidad</span>
        <select @bind="_settings.SettlementDensity">
            @foreach (var (value, name) in GeneratorSettings.DensityLevels)
            {
                <option value="@value">@name</option>
            }
        </select>
    </label>

    <label class="field">
        <span>Reinos</span>
        <select @bind="_settings.KingdomCount">
            <option value="0">Usar los reinos actuales</option>
            @for (var n = 2; n <= 8; n++)
            {
                <option value="@n">Crear @n reinos</option>
            }
        </select>
    </label>

    <div class="btn-row">
        <button class="btn" disabled="@(_busy || Store.Project.Generator is null)" @onclick="PopulateAsync">Poblar mapa</button>
    </div>

    <p class="hint" role="status">
        @(_populateStatus ?? (Store.Project.Generator is null
            ? "Generá un mapa primero."
            : "Los lugares que edites o muevas se conservan si volvés a poblar."))
    </p>
</details>

@code {
    /// <summary>Se dispara al terminar de generar, para que el editor ajuste el mapa a la pantalla.</summary>
    [Parameter] public EventCallback OnGenerated { get; set; }

    /// <summary>Se dispara al terminar de poblar, para que el editor dibuje los pines nuevos.</summary>
    [Parameter] public EventCallback OnPopulated { get; set; }

    // Una fila de semilla: nombre visible, ayuda y cómo leer y escribir el valor en _settings.
    private sealed record SeedRow(string Id, string Label, string Help, Func<int> Get, Action<int> Set);

    private GeneratorSettings _settings = GeneratorSettings.CreateRandom();
    private MapProject? _project;
    private bool _busy;
    private string? _status;
    private string? _populateStatus;

    private SeedRow PopulationSeed => new("poblados", "Semilla", "Dónde caen los poblados y cómo se llaman",
        () => _settings.SettlementSeed, v => _settings.SettlementSeed = v);

    private async Task PopulateAsync()
    {
        if (_busy || Store.Project.Generator is null) return;

        // Antes de reemplazar algo, se avisa qué se pierde.
        var warnings = new List<string>();
        if (Store.GeneratedPinCount > 0)
            warnings.Add($"Se reemplazan los {Store.GeneratedPinCount} lugares generados (los que editaste se conservan).");
        if (_settings.KingdomCount > 0 && Store.Project.Regions.Count > 0)
            warnings.Add($"Los {Store.Project.Regions.Count} reinos actuales se reemplazan por {_settings.KingdomCount} nuevos.");
        if (warnings.Count > 0 &&
            !await JS.InvokeAsync<bool>("confirm", string.Join(" ", warnings) + " ¿Continuar?"))
        {
            return;
        }

        _busy = true;
        _populateStatus = "Poblando...";
        StateHasChanged();
        await Task.Delay(1); // deja que el navegador muestre el aviso antes del trabajo pesado

        try
        {
            var (places, kingdoms) = Store.Populate(_settings);
            _populateStatus = kingdoms > 0
                ? $"Se crearon {places} lugares y {kingdoms} reinos."
                : $"Se crearon {places} lugares.";
        }
        finally
        {
            _busy = false;
        }

        await OnPopulated.InvokeAsync();
    }

    private SeedRow[] Seeds => new SeedRow[]
    {
        new("continente", "Continente", "Forma de la tierra y relieve",
            () => _settings.ContinentSeed, v => _settings.ContinentSeed = v),
        new("clima", "Clima", "Latitud y manchas de humedad",
            () => _settings.ClimateSeed, v => _settings.ClimateSeed = v),
        new("rios", "Ríos", "Variación de la lluvia que alimenta los ríos",
            () => _settings.RiverSeed, v => _settings.RiverSeed = v),
        new("biomas", "Biomas", "Irregularidad de los límites entre biomas",
            () => _settings.BiomeSeed, v => _settings.BiomeSeed = v),
    };

    private int LandPercent
    {
        get => (int)Math.Round(_settings.LandRatio * 100);
        set => _settings.LandRatio = value / 100.0;
    }

    // Las ediciones a mano se hacen desde otro panel. Cada vez que el proyecto se guarda, el
    // servicio avisa, y este panel se vuelve a dibujar para mostrar la cantidad actualizada.
    protected override void OnInitialized() => Store.StatusChanged += OnStoreChanged;

    public void Dispose() => Store.StatusChanged -= OnStoreChanged;

    private void OnStoreChanged() => _ = InvokeAsync(StateHasChanged);

    protected override void OnParametersSet()
    {
        // Si se importó otro proyecto o se empezó uno nuevo, se muestran sus parámetros.
        if (!ReferenceEquals(_project, Store.Project))
        {
            _project = Store.Project;
            _settings = _project.Generator?.Clone() ?? GeneratorSettings.CreateRandom();
            _status = null;
        }
    }

    private static void SetSeed(SeedRow seed, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
            seed.Set(Math.Clamp(value, 1, 999_999));
    }

    private async Task RandomizeAsync()
    {
        var random = GeneratorSettings.CreateRandom();
        random.LandRatio = _settings.LandRatio;
        random.CellSize = _settings.CellSize;
        random.Style = _settings.Style;
        random.SettlementDensity = _settings.SettlementDensity;
        random.KingdomCount = _settings.KingdomCount;
        await GenerateAsync(random);
    }

    private Task GenerateAsync() => GenerateAsync(_settings.Clone());

    private async Task GenerateAsync(GeneratorSettings settings)
    {
        if (_busy) return;

        // Si la imagen actual vino de un archivo, se pregunta antes de reemplazarla.
        if (Store.ImageDataUrl is not null && Store.Project.Generator is null &&
            !await JS.InvokeAsync<bool>("confirm", "El mapa generado reemplaza la imagen base actual. Los pines se mantienen. ¿Continuar?"))
        {
            return;
        }

        // Las ediciones a mano y los reinos apuntan a celdas por número. Si cambia la semilla del
        // continente o el detalle, las celdas son otras y quedarían en lugares al azar.
        var cellData = Store.CellDataCount;
        var previous = Store.Project.Generator;
        if (cellData > 0 && previous is not null && MapGenerator.ChangesMesh(previous, settings))
        {
            if (!await JS.InvokeAsync<bool>("confirm",
                    "Cambia la forma del mundo: se pierden los cambios a mano y los lugares generados que no editaste, " +
                    "y los reinos quedan sin celdas (se conservan sus nombres y colores). ¿Continuar?"))
            {
                return;
            }
            Store.ClearCellData();
        }

        _settings = settings.Clone();

        _busy = true;
        _status = "Generando...";
        StateHasChanged();

        // Generar es trabajo pesado y sin pausas: esta espera corta le da al navegador
        // la oportunidad de mostrar "Generando..." antes de empezar.
        await Task.Delay(1);

        try
        {
            var watch = Stopwatch.StartNew();
            var (world, dataUrl) = MapGenerator.Generate(settings, Store.Project.CellEdits);
            await Store.SetGeneratedImageAsync(dataUrl, settings, world);
            _status = $"Mapa generado en {watch.Elapsed.TotalSeconds:0.0} s.";
        }
        finally
        {
            _busy = false;
        }

        await OnGenerated.InvokeAsync();
    }
}
